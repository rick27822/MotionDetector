diff --git a/motiondetecter/modules/ui/adapters/CameraStream.cpp b/motiondetecter/modules/ui/adapters/CameraStream.cpp
new file mode 100644
index 0000000..d69f757
--- /dev/null
+++ b/motiondetecter/modules/ui/adapters/CameraStream.cpp
@@ -0,0 +1,133 @@
+#include "CameraStream.h"
+#include <QDir>
+#include <QFileInfo>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QtEndian>
+
+namespace ui {
+CameraStream::CameraStream(QObject *parent) : QObject(parent) {
+    process.setProcessChannelMode(QProcess::ForwardedErrorChannel);
+    stale.setSingleShot(true);
+    connect(&stale, &QTimer::timeout, this, [this] { emit statusChanged("等待新的相机画面"); });
+    connect(&process, &QProcess::readyReadStandardOutput, this, &CameraStream::readMessages);
+    connect(&process, &QProcess::errorOccurred, this, [this] {
+        stale.stop();
+        if (!selected.isNull()) emit statusChanged(process.errorString());
+    });
+    connect(&process, &QProcess::finished, this, [this] {
+        stale.stop();
+        ready = accepting = false;
+        emit recordingChanged({{"state","exited"}});
+        if (!selected.isNull()) emit statusChanged("采集进程已退出，请重新开始");
+    });
+}
+CameraStream::~CameraStream() {
+    disconnect(&process, nullptr, this, nullptr);
+    process.closeWriteChannel();
+    if (process.state() != QProcess::NotRunning && !process.waitForFinished(12000)) {
+        process.kill();
+        process.waitForFinished(1500);
+    }
+}
+void CameraStream::startRecording(const QString &directory) {
+    QJsonObject cmd{{"command","startRecording"},{"directory",directory},{"requestId",QString::number(generation)}};
+    process.write(QJsonDocument(cmd).toJson(QJsonDocument::Compact) + '\n');
+}
+void CameraStream::stopRecording() {
+    QJsonObject cmd{{"command","stopRecording"},{"requestId",QString::number(generation)}};
+    process.write(QJsonDocument(cmd).toJson(QJsonDocument::Compact) + '\n');
+}
+void CameraStream::request() {
+    if (!ready) return;
+    QJsonObject cmd{{"requestId", QString::number(generation)},
+                    {"command", selected.isNull() ? "stop" : "start"}};
+    if (!selected.isNull()) {
+        cmd["source"] = selected;
+        if (selected == "phone") cmd["host"] = host;
+    }
+    process.write(QJsonDocument(cmd).toJson(QJsonDocument::Compact) + '\n');
+}
+void CameraStream::start(const QJsonValue &source, const QString &phoneHost) {
+    stop();
+    selected = source;
+    host = phoneHost;
+    ++generation;
+    emit statusChanged("正在打开相机…");
+    if (process.state() != QProcess::NotRunning) { request(); return; }
+    ready = false;
+    buffer.clear();
+    QDir folder(qEnvironmentVariable("POSELAB_CAMERA_DIR", "modules/camera"));
+    const QString script = folder.absoluteFilePath("camera_runner.py");
+#ifdef Q_OS_WIN
+    const QString venv = ".venv/Scripts/python.exe";
+#else
+    const QString venv = ".venv/bin/python";
+#endif
+    const QString python = qEnvironmentVariable("POSELAB_PYTHON", folder.absoluteFilePath(venv));
+    if (!QFileInfo::exists(script)) {
+        emit statusChanged("找不到 camera_runner.py，请设置 POSELAB_CAMERA_DIR");
+        return;
+    }
+    process.start(python, {script});
+}
+void CameraStream::stop() {
+    ++generation;
+    selected = QJsonValue(QJsonValue::Null);
+    accepting = false;
+    session.clear();
+    lastId = lastMs = -1;
+    stale.stop();
+    request();
+}
+void CameraStream::readMessages() {
+    buffer += process.readAllStandardOutput();
+    qsizetype offset = 0;
+    auto invalid = [this] {
+        accepting = false;
+        process.kill();
+        emit statusChanged("相机数据格式错误");
+    };
+    while (buffer.size() - offset >= 4) {
+        const char *start = buffer.constData() + offset;
+        const auto len = qFromBigEndian<quint32>(start);
+        if (!len || len > 65536) return invalid();
+        if (buffer.size() - offset < 4 + len) break;
+        const auto h = QJsonDocument::fromJson(QByteArray::fromRawData(start + 4, len)).object();
+        const auto bytes = h["payloadLength"].toInteger(-1);
+        if (h["version"].toInt() != 1 || bytes < 0 || bytes > 32 * 1024 * 1024) return invalid();
+        const auto total = 4 + len + bytes;
+        if (buffer.size() - offset < total) break;
+        const auto type = h["type"].toString();
+        const auto pixels = reinterpret_cast<const uchar *>(start + 4 + len);
+        const bool ours = h["requestId"].toString() == QString::number(generation);
+        if (type == "ready") { ready = true; request(); }
+        else if (type == "recording") emit recordingChanged(h);
+        else if (type == "ack" && ours) accepting = h["command"] == "start";
+        else if (type == "pairing" && ours) {
+            const auto qr = QImage::fromData(pixels, bytes, "PNG");
+            if (qr.isNull()) return invalid();
+            emit pairingReady(qr);
+        } else if ((type == "error" && ours) || (type == "status" && accepting)) {
+            stale.stop();
+            emit statusChanged(h["message"].toString());
+        } else if (type == "frame" && accepting) {
+            const int w = h["width"].toInt(), height = h["height"].toInt();
+            const qint64 stride = h["stride"].toInteger(-1);
+            if (w <= 0 || height <= 0 || stride != qint64(w)*3 || stride > bytes ||
+                stride*height != bytes || h["pixelFormat"] != "BGR8") return invalid();
+            const QString sid = h["sessionId"].toString();
+            const auto id = h["sourceFrameId"].toInteger(-1), ms = h["timestampMs"].toInteger(-1);
+            if (sid.isEmpty() || id < 0 || ms < 0 ||
+                (session == sid && (id <= lastId || ms <= lastMs))) return invalid();
+            session = sid;
+            lastId = id;
+            lastMs = ms;
+            stale.start(550);
+            emit frameReady(QImage(pixels, w, height, stride, QImage::Format_BGR888).copy(), sid, id, ms);
+        }
+        offset += total;
+    }
+    buffer.remove(0, offset);
+}
+}
diff --git a/motiondetecter/modules/ui/adapters/CameraStream.h b/motiondetecter/modules/ui/adapters/CameraStream.h
new file mode 100644
index 0000000..dd56dc6
--- /dev/null
+++ b/motiondetecter/modules/ui/adapters/CameraStream.h
@@ -0,0 +1,34 @@
+#pragma once
+#include <QImage>
+#include <QJsonValue>
+#include <QJsonObject>
+#include <QProcess>
+#include <QTimer>
+
+namespace ui {
+class CameraStream : public QObject {
+    Q_OBJECT
+  public:
+    explicit CameraStream(QObject *parent = nullptr);
+    ~CameraStream() override;
+    void start(const QJsonValue &source, const QString &phoneHost = {});
+    void stop();
+    void startRecording(const QString &directory);
+    void stopRecording();
+  signals:
+    void frameReady(const QImage &image, const QString &sessionId, qint64 sourceFrameId, qint64 timestampMs);
+    void statusChanged(const QString &message);
+    void pairingReady(const QImage &qr);
+    void recordingChanged(const QJsonObject &result);
+  private:
+    QProcess process;
+    QTimer stale;
+    QByteArray buffer;
+    QJsonValue selected;
+    QString host, session;
+    qint64 generation = 0, lastId = -1, lastMs = -1;
+    bool ready = false, accepting = false;
+    void request();
+    void readMessages();
+};
+}
diff --git a/motiondetecter/modules/ui/adapters/RecordingPlayer.cpp b/motiondetecter/modules/ui/adapters/RecordingPlayer.cpp
new file mode 100644
index 0000000..c31619e
--- /dev/null
+++ b/motiondetecter/modules/ui/adapters/RecordingPlayer.cpp
@@ -0,0 +1,126 @@
+#include "RecordingPlayer.h"
+#include <QDir>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QtEndian>
+#include <limits>
+#include <cmath>
+
+namespace ui {
+RecordingPlayer::RecordingPlayer(QObject *parent) : QObject(parent) {
+    timer.setSingleShot(true);
+    timer.setTimerType(Qt::PreciseTimer);
+    connect(&timer, &QTimer::timeout, this, [this] { target = now(); request(); });
+}
+RecordingPlayer::~RecordingPlayer() { close(); }
+void RecordingPlayer::close() {
+    timer.stop();
+    running = busy = false;
+    length = target = anchor = displayed = 0;
+    buffer.clear();
+    if (worker) {
+        disconnect(worker, nullptr, this, nullptr);
+        worker->closeWriteChannel();
+        // Decoder is read-only. Switching sessions can cancel an outstanding seek.
+        if (worker->state() != QProcess::NotRunning) {
+            worker->kill();
+            worker->waitForFinished(1000);
+        }
+        worker->deleteLater();
+        worker = nullptr;
+    }
+}
+void RecordingPlayer::fail(const QString &message) {
+    close();
+    emit failed(message);
+}
+void RecordingPlayer::open(const QString &path) {
+    close();
+    worker = new QProcess(this);
+    worker->setProcessChannelMode(QProcess::ForwardedErrorChannel);
+    connect(worker, &QProcess::readyReadStandardOutput, this, &RecordingPlayer::readMessages);
+    connect(worker, &QProcess::errorOccurred, this, [this] { fail(worker->errorString()); });
+    connect(worker, &QProcess::finished, this, [this] {
+        readMessages();
+        if (worker) fail("录像解码进程已退出");
+    });
+    QDir dir(qEnvironmentVariable("POSELAB_CAMERA_DIR", "modules/camera"));
+#ifdef Q_OS_WIN
+    const auto venv = dir.absoluteFilePath(".venv/Scripts/python.exe");
+#else
+    const auto venv = dir.absoluteFilePath(".venv/bin/python");
+#endif
+    worker->start(qEnvironmentVariable("POSELAB_PYTHON", venv),
+                  {dir.absoluteFilePath("playback_runner.py"), path});
+}
+int RecordingPlayer::now() const {
+    return int(qBound(qint64(0), anchor + qint64(clock.elapsed() * speed), qint64(length)));
+}
+void RecordingPlayer::seek(int ms) {
+    if (!length) return;
+    timer.stop();
+    anchor = target = qBound(0, ms, length);
+    clock.restart();
+    ++generation;
+    request();
+}
+void RecordingPlayer::toggle() {
+    if (!length) return;
+    running = !running;
+    seek(running && displayed == length ? 0 : displayed);
+    emit playingChanged(running);
+}
+void RecordingPlayer::setRate(double rate) {
+    int pos = running ? now() : displayed;
+    speed = rate;
+    if (running) seek(pos);
+}
+void RecordingPlayer::request() {
+    if (!worker || busy || !length) return;
+    busy = true;
+    QJsonObject cmd{{"ms",target},{"id",generation}};
+    worker->write(QJsonDocument(cmd).toJson(QJsonDocument::Compact) + '\n');
+}
+void RecordingPlayer::readMessages() {
+    buffer += worker->readAllStandardOutput();
+    while (buffer.size() >= 4) {
+        auto n = qFromBigEndian<quint32>(buffer.constData());
+        if (!n || n > 65536) return fail("无效的录像消息头");
+        if (buffer.size() < 4+n) return;
+        auto h = QJsonDocument::fromJson(buffer.mid(4,n)).object();
+        auto bytes = h["payloadLength"].toInteger(-1);
+        if (h["version"].toInt() != 1 || bytes < 0 || bytes > 32*1024*1024)
+            return fail("无效的录像载荷");
+        if (buffer.size() < 4+n+bytes) return;
+        auto type = h["type"].toString();
+        if (type == "error") return fail(h["message"].toString());
+        if (type == "opened") {
+            auto ms = h["durationMs"].toInteger();
+            if (ms <= 0 || ms > std::numeric_limits<int>::max()) return fail("录像时长无效");
+            length = int(ms);
+            emit opened(length);
+            seek(0);
+        } else if (type == "frame") {
+            busy = false;
+            if (h["requestId"].toInteger(-1) != generation) request();
+            else {
+                int w = h["width"].toInt(), ht = h["height"].toInt();
+                if (w <= 0 || ht <= 0 || w > bytes/3 || qint64(w)*3*ht != bytes)
+                    return fail("录像图像尺寸无效");
+                auto data = reinterpret_cast<const uchar *>(buffer.constData()+4+n);
+                auto img = QImage(data,w,ht,w*3,QImage::Format_BGR888).copy();
+                displayed = h["ms"].toInt();
+                emit frameReady(img, displayed, h["sourceFrameId"].toInteger(), h["timestampMs"].toInteger());
+                if (running && displayed >= length) {
+                    running = false;
+                    emit playingChanged(false);
+                } else if (running) {
+                    int delay = int(std::ceil((h["nextMs"].toInt() - now())/speed));
+                    timer.start(qMax(0,delay));
+                }
+            }
+        } else return fail("不支持的录像消息");
+        buffer.remove(0,4+n+bytes);
+    }
+}
+}
diff --git a/motiondetecter/modules/ui/adapters/RecordingPlayer.h b/motiondetecter/modules/ui/adapters/RecordingPlayer.h
new file mode 100644
index 0000000..a98c7be
