+void RealtimePage::connectCamera(bool phone, int deviceIndex) {
+    if (!m_source->isEnabled()) return;
+    if (!phone && deviceIndex != m_pcIndex) {
+        if (m_sampleIndex == -2) disconnectCamera();
+        m_pcIndex = deviceIndex;
+    }
+    int index = m_source->findData(phone ? -3 : -2);
+    if (index < 0) return;
+    if (m_source->currentIndex() != index) m_source->setCurrentIndex(index);
+    else if (!m_started) toggleCamera();
+}
+void RealtimePage::disconnectCamera() {
+    if (m_sampleIndex < -1 && m_started) toggleCamera();
+}
+void RealtimePage::selectPoseOnly() {
+    if (cameraSelected()) m_source->setCurrentIndex(0);
+}
+void RealtimePage::toggleCamera() {
+    if (m_started) {
+        camera->stop();
+        m_pairing = {};
+        m_started = false;
+        emit camera->statusChanged("已停止采集");
+        emit captureSourceChanged({});
+    } else {
+        QString deviceId = QString("usb:%1").arg(m_pcIndex);
+        const bool rtsp = m_sampleIndex == -3 && m_state->config.networkProtocol == "RTSP";
+        if (rtsp) {
+            bool ok = false;
+            const QString address = QInputDialog::getText(window(),"连接网络摄像头","摄像头的 RTSP 地址",
+                                                         QLineEdit::Normal,{},&ok).trimmed();
+            if (!ok || address.isEmpty()) return;
+            const QUrl url(address,QUrl::StrictMode);
+            if (url.scheme()!="rtsp" || !url.isValid() || url.host().isEmpty()) {
+                emit camera->statusChanged("请输入完整的 rtsp:// 摄像头地址");
+                return;
+            }
+            deviceId = address;
+        } else if (m_sampleIndex == -3) {
+            QStringList addresses;
+            for (const auto &a : QNetworkInterface::allAddresses())
+                if (a.protocol() == QAbstractSocket::IPv4Protocol && !a.isLoopback())
+                    addresses.append(a.toString());
+            bool ok = false;
+            m_phoneHost = QInputDialog::getItem(window(), "手机扫码", "手机可访问的电脑 Wi-Fi 地址",
+                                                addresses, qMax(0, addresses.indexOf(m_phoneHost)), true, &ok);
+            if (!ok || m_phoneHost.isEmpty()) return;
+            deviceId = "phone:"+m_phoneHost;
+        }
+        m_started = true;
+        applyCaptureSettings();
+        emit captureSourceChanged(rtsp ? "RTSP 网络摄像头" : m_sampleIndex == -3 ? "手机摄像头" : "电脑摄像头");
+        camera->connectDevice(deviceId);
+        camera->startStream();
+    }
+    refresh();
+}
+void RealtimePage::applyCaptureSettings() {
+    const auto &config = m_state->config;
+    const auto parts = config.resolution.split(QChar(0x00d7));
+    const int networkIndex = m_source->findData(-3);
+    if (networkIndex >= 0) m_source->setItemText(networkIndex, config.networkProtocol=="RTSP" ? "RTSP 摄像头" : "手机扫码");
+    camera->setCaptureSettings(QSize(parts.value(0).trimmed().toInt(),parts.value(1).trimmed().toInt()),
+                               config.fps,config.adaptiveQuality);
+}
 void RealtimePage::refresh() {
+    const bool live = m_realtime->enabled();
+    const bool capture = cameraSelected();
+    m_hintCard->setVisible(!capture || live);
+    m_kneeProgress->setVisible(!capture || live);
+    if (capture) {
+        refreshRecordButton();
+        for (const auto &pair : m_angleValues) pair.second->setText("—");
+        m_detect->setText(m_started ? "停止采集" : "开始采集");
+        m_detect->setEnabled(true);
+        m_confidence->setText(QString::number(m_state->config.confidence, 'f', 2));
+        video->setMirror(m_state->config.mirror);
