+void RealtimePage::toggleCamera() {
+    if (m_started) {
+        camera->stop();
+        m_pairing = {};
+        m_started = false;
+        emit camera->statusChanged("已停止采集");
+    } else {
+        if (m_sampleIndex == -3) {
+            QStringList addresses;
+            for (const auto &a : QNetworkInterface::allAddresses())
+                if (a.protocol() == QAbstractSocket::IPv4Protocol && !a.isLoopback())
+                    addresses.append(a.toString());
+            bool ok = false;
+            m_phoneHost = QInputDialog::getItem(this, "手机扫码", "手机可访问的电脑 Wi-Fi 地址",
+                                                addresses, qMax(0, addresses.indexOf(m_phoneHost)), true, &ok);
+            if (!ok || m_phoneHost.isEmpty()) return;
+        }
+        m_started = true;
+        camera->start(m_sampleIndex == -3 ? QJsonValue("phone") : QJsonValue(0), m_phoneHost);
+    }
+    refresh();
+}
 void RealtimePage::refresh() {
+    if (m_sampleIndex < -1 && m_realtime->enabled()) {
+        m_source->setCurrentIndex(0);
+        return;
+    }
+    if (m_sampleIndex < -1) {
+        for (const auto &pair : m_angleValues) pair.second->setText("—");
+        m_detect->setText(m_started ? "停止采集" : "开始采集");
+        m_detect->setEnabled(true);
+        m_confidence->setText(QString::number(m_state->config.confidence, 'f', 2));
+        video->setMirror(m_state->config.mirror);
+        return;
+    }
     core::PoseResult pose = m_sampleIndex >= 0 && m_sampleIndex < m_samples.size()
                                 ? m_samples[m_sampleIndex]
                                 : VideoView::referencePose();
